managed implementation in class zbp_r_prc_demo_br_ppprc unique;
strict ( 2 );
with draft;

// Post-processing decoupled with ABAP-PRC: the save only registers a process,
// the BAPIs run after the RAP commit, each step in its own session
define behavior for ZR_PRC_DEMO_BR_PpPrc alias DemoOrder
persistent table zprc_demo_brc
draft table zprc_demo_brc_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
// "and cleanup": the saver may redefine CLEANUP to clear its own buffer
with additional save and cleanup
{
  field ( numbering : managed, readonly ) OrderUUID;
  field ( readonly ) LocalCreatedBy, LocalCreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  create;
  update;
  delete;

  // Start: only if the order has no open process. Remembered, registered in the save.
  action ( features : instance ) startProcess result [1] $self;
  // Resume: only if the latest process is not finished. Delegates to the PRC.
  action ( features : instance ) resumeProcess result [1] $self;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zprc_demo_brc
    {
      OrderUUID          = order_uuid;
      Description        = description;
      ErrorMode          = error_mode;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }
}